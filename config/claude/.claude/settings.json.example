{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/rpg-hud:~/.claude/mods/slime-band:~/.claude/mods/skill-bar:~/.claude/mods/rpg-spinner"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git stash list*)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v*)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm test *)",
      "Bash(ng build*)",
      "Bash(ng test*)",
      "Bash(ng lint*)",
      "Bash(ng generate *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(pwd)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(jq *)",
      "Bash(brew list *)",
      "Bash(brew info *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .)",
      "Bash(git branch -D *)",
      "Bash(> /dev/*)",
      "Bash(mkfs*)",
      "Bash(dd *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(eval *)",
      "Bash(npm publish*)",
      "Bash(dotnet nuget push *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.config/claude/cc-notify.sh\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.config/claude/cc-notify.sh\" pretool"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.config/claude/cc-notify.sh\" dec"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.config/claude/cc-notify.sh\" stop",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "theme": "dark-daltonized",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/rpg-statusline.sh\"",
    "refreshInterval": 2
  }
}
