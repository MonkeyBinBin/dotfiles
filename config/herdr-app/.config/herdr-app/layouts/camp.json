{
  "id": "root",
  "type": "column",
  "theme": "camp",
  "ui_font": "Cubic 11",
  "preview": "layouts/camp.svg",
  "titlebar": "none",
  "traffic_lights": [
    294,
    26
  ],
  "background": {
    "image": "mods/camp/assets/sky.png",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "padding": 8,
  "gap": 8,
  "children": [
    {
      "id": "topbar",
      "type": "row",
      "size": {
        "px": 76
      },
      "gap": 8,
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 268
          },
          "window_drag": true,
          "content": {
            "mod": "camp",
            "props": {
              "role": "hero"
            }
          }
        },
        {
          "id": "tabs",
          "type": "block",
          "window_drag": true,
          "content": {
            "mod": "camp-tabs"
          }
        }
      ]
    },
    {
      "id": "middle",
      "type": "row",
      "gap": 8,
      "resizable": false,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 268
          },
          "min": 44,
          "max": 480,
          "resizable": false,
          "gap": 8,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "camp-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 2
              },
              "min": 90,
              "content": {
                "mod": "camp",
                "props": {
                  "role": "quests"
                }
              }
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": {
                "px": 69
              },
              "content": {
                "mod": "camp",
                "props": {
                  "role": "footer"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 2,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 3,
                    "color": "#6a421e"
                  },
                  "focus": {
                    "width": 3,
                    "color": "#e8b060"
                  },
                  "header": {
                    "content": {
                      "mod": "camp",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ],
              "border": {
                "width": 3,
                "color": "#6a421e"
              },
              "radius": 2,
              "shadow": "md"
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 144
      },
      "content": {
        "mod": "camp",
        "props": {
          "role": "band"
        }
      }
    }
  ]
}
